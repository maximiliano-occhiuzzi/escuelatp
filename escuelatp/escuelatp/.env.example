# Copiar este archivo como ".env" (sin .example) y completar los valores.
# El archivo ".env" NO se sube a Git (esta en el .gitignore).

# Secreto con el que Auth firma los JWT y el Gateway los valida.
# Tiene que estar en BASE64 y ser largo (el codigo lo decodifica).
# Para generarlo:   openssl rand -base64 48
JWT_SECRET=cambiar-por-un-valor-generado-con-openssl

# Clave del usuario root de MySQL (la usan los microservicios para conectarse)
MYSQL_ROOT_PASSWORD=cambiar

# Usuario y clave de RabbitMQ
RABBITMQ_USER=escuela
RABBITMQ_PASSWORD=cambiar
