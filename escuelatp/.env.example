# OPCIONAL. Con docker compose up -d NO hace falta: todo tiene valores por defecto.
# Para usar otros valores, copiar este archivo como ".env" (sin .example).
# El archivo ".env" NO se sube a Git (esta en el .gitignore).

# Secreto con el que Auth firma los JWT y el Gateway los valida.
# Tiene que estar en BASE64 y ser largo. En PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=

# RabbitMQ
RABBITMQ_USER=escuela
RABBITMQ_PASSWORD=escuela

# Una base MySQL por microservicio: clave del usuario de la app y del root de cada una
AUTH_DB_PASSWORD=auth_pass
AUTH_DB_ROOT_PASSWORD=root_auth_pass
ALUMNO_DB_PASSWORD=alumno_pass
ALUMNO_DB_ROOT_PASSWORD=root_alumno_pass
CURSOS_DB_PASSWORD=cursos_pass
CURSOS_DB_ROOT_PASSWORD=root_cursos_pass
ADMIN_DB_PASSWORD=admin_pass
ADMIN_DB_ROOT_PASSWORD=root_admin_pass
